<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Task #100: the split daemon binary (the CLI is src/OllamaRouter.Cli). -->
    <AssemblyName>ollamarouter-server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <PublishAot>true</PublishAot>
      <InvariantGlobalization>true</InvariantGlobalization>
      <ServerGarbageCollection>false</ServerGarbageCollection>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Required for single-file publish: Microsoft.ML.Tokenizers ships native libraries. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Task #110: the ONE new AOT warning introduced by the Pmad.KeySharp reference — ILC flags
       KeySharp.Glue.GetLibrarySearchPaths' use of Assembly.Location (IL3000, which would be
       empty in a single-file app). The canonical publish is NOT single-file (the natives sit
       next to the binary) and no code in this repo reads Assembly.Location, so the warning is
       inert; it is suppressed (AOT publishes only) to keep the AOT pass clean of package-
       attributable warnings. -->
  <!-- Task #111: IL2104/IL3053 are the per-ASSEMBLY singlewarn summaries ILC emits when a
       package's internals carry trim/AOT analysis warnings (Serilog's IL2104 predates this
       change). The OllamaSharp 5.5.2 roots are all generic System.Text.Json calls INSIDE the
       package assembly (JsonSerializer.Serialize/Deserialize/SerializeToElement overloads
       marked RequiresDynamicCode/RequiresUnreferencedCode) — its IL unconditionally calls the
       options-based overloads, so the consumer cannot prove them source-generated statically.
       At RUNTIME they are reflection-free: every OllamaApiClient construction passes the
       source-generated OllamaSharpWireContext (AOT context mode), runtime-verified against the
       full chat surface. The summaries are therefore inert; suppressed (AOT publishes only)
       alongside the IL3000 precedent above. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL3000;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.12" />
    <!-- Runtime OpenAPI document for the /api/router/ management API (task #51): the .NET 10
         built-in generator ships as this first-party package (not framework-internal) and is
         officially NativeAOT-compatible — schemas resolve from the source-generated
         OllamaRouterJsonSerializerContext. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Canonical protocol contract for the bidirectional Ollama/OpenAI translators (task #59).
         Pinned to 10.9.0, the exact version already in the transitive closure via
         Pmad.AI 0.0.1 -> Microsoft.Extensions.AI 10.9.0: this direct reference adds zero
         new packages to the dependency graph. -->
         <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
         <!-- Task #111: native Ollama IChatClient binding for the converter dispatch path. Pinned to
         5.5.2 (latest at adoption): it carries the request-side thinking-preservation fix
         (TextReasoningContent -> message.thinking) and the opt-in AOT surface — a CONSUMER-defined
         JsonSerializerContext accepted by the OllamaApiClient(HttpClient, ...) constructor (the
         package's own generated context is internal). Native AOT: every construction in the server
         passes the source-generated OllamaSharpWireContext (Serialization/OllamaSharpWireContext.cs).
         NuGet graph: depends on Microsoft.Extensions.AI(.Abstractions) 10.8.0, unified up to the
         10.9.0 already resolved via Pmad.AI 0.0.4 — adds exactly one package, no downgrades. -->
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!-- Task #110: cross-platform OS keyring access (Windows Credential Manager / macOS Keychain /
         Linux Secret Service) for OpenAI target API keys. Pinned to 0.1.0: net10.0 TFM, zero
         managed dependencies (adds nothing to the dependency graph), dynamic NativeLibrary
         loading (no unsafe / no reflection) - NativeAOT-safe with the existing publish
         properties; the bundled skeychain natives ride the single-file self-extract path. -->
    <PackageReference Include="Pmad.KeySharp" Version="0.1.0" />
    <PackageReference Include="Pmad.AI" Version="0.0.4" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OllamaRouter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared client SDK (task #98): wire DTOs + IKeyProtector/SecretFilePermissions moved
         out of the server; System.Security.Cryptography.ProtectedData now flows here
         transitively (only DpapiKeyProtector consumes it). -->
    <ProjectReference Include="..\OllamaRouter.Client\OllamaRouter.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Monitor page served verbatim by GET /monitor (OllamaRouter.Endpoints.monitor.html). -->
    <EmbeddedResource Include="Endpoints\monitor.html" />
  </ItemGroup>
</Project>
