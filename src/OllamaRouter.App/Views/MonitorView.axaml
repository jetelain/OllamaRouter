<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OllamaRouter.App.Views"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             xmlns:converters="using:OllamaRouter.App.Converters"
             x:Class="OllamaRouter.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">
  <UserControl.Styles>
    <!-- Failed requests render the STATUS text in the app's error red (task #117). -->
    <Style Selector="TextBlock.status-failed">
      <Setter Property="Foreground" Value="#FF7B7B"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="12,12,12,48">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>

      <!-- 1. FLEET STATUS & RUNTIME AVAILABILITY (Top section, exactly matching web monitor) -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,auto">
            <TextBlock Grid.Column="0" Text="Fleet" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
          </Grid>

          <!-- Fleet table header -->
          <Grid ColumnSpacing="8" ColumnDefinitions="140,80,90,148,68,58,80,140" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="HW" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="LIVENESS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="ACTIVE MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="KEEP-ALIVE" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="IN-FLIGHT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="CONTEXT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="7" Text="ENABLED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>

          <!-- Fleet rows -->
          <ItemsControl ItemsSource="{Binding FleetRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8" ColumnDefinitions="140,80,90,148,68,58,80,140" Margin="0,4" VerticalAlignment="Center">
                  <!-- Target with color emoji and target color text; the URL (column removed, task #145)
                       stays one hover away via the cell tooltip. -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding Url}">
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding HardwareProfile, TargetNullValue='-'}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Liveness}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding ActiveModel, TargetNullValue='-'}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding KeepAliveDisplay}" VerticalAlignment="Center" TextAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="{Binding InFlightRequests}" VerticalAlignment="Center" TextAlignment="Right"/>
                  <TextBlock Grid.Column="6" Text="{Binding ContextAllocation, TargetNullValue='-'}" VerticalAlignment="Center" TextAlignment="Right"/>

                  <!-- Enable/Disable toggle (task #161): ONE interactive CheckBox — the
                       retired display-only CheckBox + separate "Toggle" button convention. -->
                  <CheckBox Grid.Column="7" IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                            Command="{Binding ToggleCommand}" CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Preload policy: cloud/server = ∞ (forever) · desktop = 15m · unclassifiable = router default"
                     Foreground="{DynamicResource SemiColorText2}" FontSize="11" Margin="0,4,0,0"/>

          <!-- Reclaim local VRAM button (Gaming Mode) right under Fleet -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Content="🎮 Reclaim local VRAM (Gaming Mode)" Classes="Warning" Click="OnReclaimLocalVramClick" FontWeight="Bold"/>
            <TextBlock Text="{Binding ReclaimResultText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 2. STATISTICS TABLE (Today & Last 7 Days) -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Statistics" FontWeight="Bold" FontSize="16"/>

          <!-- Stats table header -->
          <Grid ColumnSpacing="8" ColumnDefinitions="120,64,70,70,64,70,70,80" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="TODAY REQ" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="TODAY IN" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="TODAY OUT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="7D REQ" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="7D IN" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="7D OUT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="7" Text="7D GPU TIME" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
          </Grid>

          <!-- Stats rows -->
          <ItemsControl ItemsSource="{Binding StatisticsRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="0,3">
                  <Grid ColumnSpacing="8" ColumnDefinitions="120,64,70,70,64,70,70,80">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                 FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                                 Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TodayRequests}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding TodayInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding TodayOutputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding Last7DaysRequests}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="{Binding Last7DaysInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="{Binding Last7DaysOutputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="{Binding Last7DaysElapsedSeconds, Converter={x:Static views:DurationSecondsConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 3. SUMMARY ROW: USAGE RATIO + COST & SAVINGS CARDS -->
      <Grid ColumnDefinitions="*,auto" ColumnSpacing="14">
        <!-- Target usage ratio (last 7 days) -->
        <Border Grid.Column="0" Theme="{DynamicResource CardBorder}" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,auto">
              <TextBlock Grid.Column="0" Text="Target usage ratio (last 7 days)" FontSize="13" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Grid.Column="1" Text="{Binding UsageRatioSummary}" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
            </Grid>

            <!-- Segmented 7-day usage ratio bar (web-monitor parity): one colored segment per target, width ∝ token share -->
            <Grid Height="18">
              <Border Background="#181818" CornerRadius="6" IsVisible="{Binding HasUsageActivity}">
                <ItemsControl ItemsSource="{Binding UsageRatios}" Margin="1">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <views:ProportionalPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorUsageRatioItem">
                      <Border Background="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                              CornerRadius="2" Margin="0,0,2,0"
                              views:ProportionalPanel.Weight="{Binding Percentage}"
                              ToolTip.Tip="{Binding FormattedTooltip}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <TextBlock Text="No token activity in the last 7 days"
                         FontSize="11" FontStyle="Italic" Foreground="#666666"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding HasUsageActivity, Converter={x:Static converters:BoolNegateConverter.Instance}}"/>
            </Grid>

            <!-- Usage Legend with color dots (task #117): one horizontal row per chunk of ≤2
                 targets (UsageRatioLegendRows) so >2 targets break onto a second line within the
                 panel width instead of one unbounded single row. -->
            <ItemsControl ItemsSource="{Binding UsageRatioLegendRows}" IsVisible="{Binding HasUsageActivity}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MonitorUsageRatioItem">
                        <Border Margin="0,0,14,6">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                       FontSize="12" FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name, Converter={x:Static views:TargetNameConverter.Instance}}"
                                       FontSize="12"
                                       Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FormattedSummary, StringFormat=': {0}'}"
                                       FontSize="12" Foreground="{DynamicResource SemiColorText1}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Cost & Savings cards (matching web monitor) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasCost}">
          <!-- Actual 7-Day Savings Card -->
          <Border Theme="{DynamicResource CardBorder}" Padding="14" Width="260"
                  BorderBrush="#34E0A1" BorderThickness="4,1,1,1">
            <StackPanel Spacing="4">
              <TextBlock Text="Actual 7-Day Savings" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Text="{Binding FormattedEstimatedSavings}" FontSize="24" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="net of electricity" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>

              <!-- Per-target savings list -->
              <ItemsControl ItemsSource="{Binding PerTargetSavingsList}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FormattedText}" FontSize="11"
                               Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               Margin="0,0,8,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding FormattedElectricity}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Cloud Overflow Cost Card -->
          <Border Theme="{DynamicResource CardBorder}" Padding="14" Width="200"
                  BorderBrush="#C48BFF" BorderThickness="4,1,1,1">
            <StackPanel Spacing="4">
              <TextBlock Text="Cloud Overflow Cost" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Text="{Binding FormattedCloudOverflow}" FontSize="24" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="7 days" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 4. IN-PROGRESS REQUESTS -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="In-Progress Requests" FontWeight="Bold" FontSize="16"/>
          <Grid ColumnSpacing="8" ColumnDefinitions="120,150,72,64,64,*,100" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="EST. TOKENS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="ELAPSED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="REASONING" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="SESSION" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="AGENT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding ActiveRequests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="8" ColumnDefinitions="120,150,72,64,64,*,100" Margin="0,3">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding EstimatedPromptTokens, Converter={x:Static views:TokenCountConverter.Instance}, StringFormat='~{0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="{Binding ElapsedMs, Converter={x:Static views:DurationMsConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="{Binding ReasoningEffort, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding SessionId, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding AgentId, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AgentId}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 5. RECENT REQUESTS -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Recent Requests" FontWeight="Bold" FontSize="16"/>
          <Grid ColumnSpacing="8" ColumnDefinitions="76,120,150,64,64,64,64,52" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TIMESTAMP" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="PROMPT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="CACHED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="RESPONSE" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="6" Text="ELAPSED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
            <TextBlock Grid.Column="7" Text="STATUS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding RecentRequests}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorRecentRequestRow">
                  <Grid ColumnSpacing="8" ColumnDefinitions="76,120,150,64,64,64,64,52" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                 FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                                 Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ActualPromptTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding CachedInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="{Binding ActualResponseTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="{Binding ElapsedMs, Converter={x:Static views:DurationMsConverter.Instance}}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="{Binding StatusCode, TargetNullValue='-'}" VerticalAlignment="Center" TextAlignment="Right"
                               Classes.status-failed="{Binding IsFailure}"/>
                  </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
