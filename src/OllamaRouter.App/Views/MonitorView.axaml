<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             x:Class="OllamaRouter.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        <Button Content="Reclaim Local VRAM (Gaming Mode)" Click="OnReclaimLocalVramClick" FontWeight="Bold"/>
        <TextBlock Text="{Binding ReclaimResultText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Savings / cost KPI cards (GET /monitor/api cost) -->
      <WrapPanel>
        <Border Padding="12" Margin="0,0,8,8" Background="#1E2A38" CornerRadius="6" MinWidth="220">
          <StackPanel Spacing="2">
            <TextBlock Text="Actual 7-Day Savings" Opacity="0.7"/>
            <TextBlock Text="{Binding SavingsEstimated, StringFormat='{}{0:F2}', TargetNullValue='-'}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding SavingsCurrency, TargetNullValue='-'}" Opacity="0.7"/>
          </StackPanel>
        </Border>
        <Border Padding="12" Margin="0,0,8,8" Background="#1E2A38" CornerRadius="6" MinWidth="220">
          <StackPanel Spacing="2">
            <TextBlock Text="Cloud Overflow Cost" Opacity="0.7"/>
            <TextBlock Text="{Binding SavingsCloudOverflow, StringFormat='{}{0:F2}', TargetNullValue='-'}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="7 days" Opacity="0.7"/>
          </StackPanel>
        </Border>
        <Border Padding="12" Margin="0,0,8,8" Background="#1E2A38" CornerRadius="6" MinWidth="220">
          <StackPanel Spacing="2">
            <TextBlock Text="Electricity Cost" Opacity="0.7"/>
            <TextBlock Text="{Binding SavingsElectricity, StringFormat='{}{0:F2}', TargetNullValue='-'}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="7 days" Opacity="0.7"/>
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- In-progress requests -->
      <StackPanel Spacing="4">
        <TextBlock Text="In-Progress Requests" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding ActiveRequests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,1">
                <TextBlock Text="{Binding Target}" Width="130"/>
                <TextBlock Text="{Binding Model}" Width="240"/>
                <TextBlock Text="{Binding EstimatedPromptTokens, StringFormat='~{0} tok'}"/>
                <TextBlock Text="{Binding ElapsedMs, StringFormat='{}{0:0} ms'}"/>
                <TextBlock Text="{Binding ReasoningEffort}" Opacity="0.7"/>
                <TextBlock Text="{Binding SessionId}" Opacity="0.7"/>
                <TextBlock Text="{Binding AgentId}" Opacity="0.7"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Recent requests -->
      <StackPanel Spacing="4">
        <TextBlock Text="Recent Requests" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding RecentRequests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="150,130,220,90,90,90,80,70,60" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding Timestamp}"/>
                <TextBlock Grid.Column="1" Text="{Binding Target}"/>
                <TextBlock Grid.Column="2" Text="{Binding Model}"/>
                <TextBlock Grid.Column="3" Text="{Binding ActualPromptTokens, TargetNullValue='-'}"/>
                <TextBlock Grid.Column="4" Text="{Binding ActualResponseTokens, TargetNullValue='-'}"/>
                <TextBlock Grid.Column="5" Text="{Binding CachedInputTokens, TargetNullValue='-'}"/>
                <TextBlock Grid.Column="6" Text="{Binding ElapsedMs, StringFormat='{}{0:0} ms'}"/>
                <TextBlock Grid.Column="7" Text="{Binding StatusCode, TargetNullValue='-'}"/>
                <TextBlock Grid.Column="8" Text="{Binding Success}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 7-day per-target breakdown -->
      <StackPanel Spacing="4">
        <TextBlock Text="7-Day Per-Target Breakdown" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding TargetBreakdown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="160,80,100,100,110,110" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding Target}"/>
                <TextBlock Grid.Column="1" Text="{Binding Requests}"/>
                <TextBlock Grid.Column="2" Text="{Binding InputTokens}"/>
                <TextBlock Grid.Column="3" Text="{Binding OutputTokens}"/>
                <TextBlock Grid.Column="4" Text="{Binding CachedInputTokens}"/>
                <TextBlock Grid.Column="5" Text="{Binding ElapsedSeconds, StringFormat='{}{0:F1} s GPU'}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Fleet runtime toggles -->
      <StackPanel Spacing="4">
        <TextBlock Text="Fleet (runtime availability)" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding FleetRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="150,90,*,90,210" Margin="0,1" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Liveness}"/>
                <TextBlock Grid.Column="2" Text="{Binding ActiveModel}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding InFlightRequests}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False"
                            VerticalAlignment="Center"/>
                  <Button Content="Toggle" Command="{Binding ToggleCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
