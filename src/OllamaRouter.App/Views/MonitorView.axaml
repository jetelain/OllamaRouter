<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OllamaRouter.App.Views"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             x:Class="OllamaRouter.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="12,12,12,48">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>

      <!-- 1. FLEET STATUS & RUNTIME AVAILABILITY (Top section, exactly matching web monitor) -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,auto">
            <TextBlock Grid.Column="0" Text="Fleet" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
          </Grid>

          <!-- Fleet table header -->
          <Grid ColumnDefinitions="140,180,80,90,180,90,80,80,140" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="URL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="HW" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="LIVENESS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="ACTIVE MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="KEEP-ALIVE" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="IN-FLIGHT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7" Text="CONTEXT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="8" Text="ENABLED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>

          <!-- Fleet rows -->
          <ItemsControl ItemsSource="{Binding FleetRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="140,180,80,90,180,90,80,80,140" Margin="0,4" VerticalAlignment="Center">
                  <!-- Target with color emoji and target color text -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding Url, TargetNullValue='-'}"
                             Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding HardwareProfile, TargetNullValue='-'}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Liveness}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding ActiveModel, TargetNullValue='-'}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding KeepAliveDisplay}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding InFlightRequests}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="7" Text="{Binding ContextAllocation, TargetNullValue='-'}" VerticalAlignment="Center"/>

                  <!-- Enable/Disable toggle -->
                  <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <Button Content="Toggle" Command="{Binding ToggleCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Padding="8,2" FontSize="11"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Preload policy: cloud/server = ∞ (forever) · desktop = 15m · unclassifiable = router default"
                     Foreground="{DynamicResource SemiColorText2}" FontSize="11" Margin="0,4,0,0"/>

          <!-- Reclaim local VRAM button (Gaming Mode) right under Fleet -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Content="🎮 Reclaim local VRAM (Gaming Mode)" Classes="Warning" Click="OnReclaimLocalVramClick" FontWeight="Bold"/>
            <TextBlock Text="{Binding ReclaimResultText}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 2. STATISTICS TABLE (Today & Last 7 Days) -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="Statistics" FontWeight="Bold" FontSize="16"/>

          <!-- Stats table header -->
          <Grid ColumnDefinitions="140,80,90,90,80,90,90,100" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="TODAY REQ" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="TODAY IN" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="TODAY OUT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="7D REQ" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="7D IN" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="7D OUT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7" Text="7D GPU TIME" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>

          <!-- Stats rows -->
          <ItemsControl ItemsSource="{Binding StatisticsRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="0,3">
                  <Grid ColumnDefinitions="140,80,90,90,80,90,90,100">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                 FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                                 Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TodayRequests}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TodayInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding TodayOutputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Last7DaysRequests}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Last7DaysInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{Binding Last7DaysOutputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{Binding Last7DaysElapsedSeconds, Converter={x:Static views:DurationSecondsConverter.Instance}}" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 3. SUMMARY ROW: USAGE RATIO + COST & SAVINGS CARDS -->
      <Grid ColumnDefinitions="*,auto" ColumnSpacing="14">
        <!-- Target usage ratio (last 7 days) -->
        <Border Grid.Column="0" Theme="{DynamicResource CardBorder}" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,auto">
              <TextBlock Grid.Column="0" Text="Target usage ratio (last 7 days)" FontSize="13" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Grid.Column="1" Text="{Binding UsageRatioSummary}" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
            </Grid>

            <!-- Usage Legend with color dots -->
            <ItemsControl ItemsSource="{Binding UsageRatios}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="10" Height="10" Fill="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                 FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name, Converter={x:Static views:TargetNameConverter.Instance}}"
                                 Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                 FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FormattedSummary, StringFormat=': {0}'}"
                                 Foreground="{DynamicResource SemiColorText1}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Cost & Savings cards (matching web monitor) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasCost}">
          <!-- Actual 7-Day Savings Card -->
          <Border Theme="{DynamicResource CardBorder}" Padding="14" Width="260"
                  BorderBrush="#34E0A1" BorderThickness="4,1,1,1">
            <StackPanel Spacing="4">
              <TextBlock Text="Actual 7-Day Savings" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Text="{Binding FormattedEstimatedSavings}" FontSize="24" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="net of electricity" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>

              <!-- Per-target savings list -->
              <ItemsControl ItemsSource="{Binding PerTargetSavingsList}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FormattedText}" FontSize="11"
                               Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               Margin="0,0,8,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding FormattedElectricity}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Cloud Overflow Cost Card -->
          <Border Theme="{DynamicResource CardBorder}" Padding="14" Width="200"
                  BorderBrush="#C48BFF" BorderThickness="4,1,1,1">
            <StackPanel Spacing="4">
              <TextBlock Text="Cloud Overflow Cost" FontSize="12" Foreground="{DynamicResource SemiColorText2}"/>
              <TextBlock Text="{Binding FormattedCloudOverflow}" FontSize="24" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="7 days" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- 4. IN-PROGRESS REQUESTS -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="In-Progress Requests" FontWeight="Bold" FontSize="16"/>
          <Grid ColumnDefinitions="140,240,110,90,90,120,*" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="EST. TOKENS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="ELAPSED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="REASONING" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="SESSION" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="AGENT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding ActiveRequests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="140,240,110,90,90,120,*" Margin="0,3">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding EstimatedPromptTokens, Converter={x:Static views:TokenCountConverter.Instance}, StringFormat='~{0}'}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding ElapsedMs, Converter={x:Static views:DurationMsConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding ReasoningEffort, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding SessionId, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding AgentId, TargetNullValue='-'}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 5. RECENT REQUESTS -->
      <Border Theme="{DynamicResource CardBorder}" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Recent Requests" FontWeight="Bold" FontSize="16"/>
          <Grid ColumnDefinitions="140,140,220,90,90,90,90,70,60" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="TIMESTAMP" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="TARGET" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="MODEL" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="PROMPT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="RESPONSE" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="CACHED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="ELAPSED" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7" Text="STATUS" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="8" Text="RESULT" Foreground="{DynamicResource SemiColorText2}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding RecentRequests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="140,140,220,90,90,90,90,70,60" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Target, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Target, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding ActualPromptTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding ActualResponseTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding CachedInputTokens, Converter={x:Static views:TokenCountConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding ElapsedMs, Converter={x:Static views:DurationMsConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="7" Text="{Binding StatusCode, TargetNullValue='-'}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="8" Text="{Binding Success}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
