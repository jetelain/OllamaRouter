<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OllamaRouter.App.Views"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             xmlns:converters="using:OllamaRouter.App.Converters"
             x:Class="OllamaRouter.App.Views.FleetTargetsView"
             x:DataType="vm:FleetTargetsViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="12,12,12,48">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        <Button Content="Add Target" Classes="Primary" Click="OnAddTargetClick"/>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10" Padding="12" Theme="{DynamicResource CardBorder}">
              <StackPanel Spacing="8">
                <!-- Identity row: name + liveness + enabled cluster + actions -->
                <Grid ColumnDefinitions="*,72,auto,auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                               FontFamily="Segoe UI Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name, Converter={x:Static views:TargetNameConverter.Instance}}"
                               Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                               FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Liveness}" VerticalAlignment="Center"/>
                  <!-- Monitor-parity enabled cluster: label + state checkbox + Toggle button -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Enabled" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <Button Content="Toggle" Click="OnTogglePersistedClick" Tag="{Binding}"
                            ToolTip.Tip="Toggle the persisted (config) enablement flag"
                            Padding="8,2" FontSize="11" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button Content="{Binding UpdateHardwareButtonContent}" IsEnabled="{Binding CanUpdateHardware}"
                            Click="OnUpdateHardwareClick" Tag="{Binding}"
                            ToolTip.Tip="Re-run the daemon-side hardware probe for this target (overwrites the stored profile)"/>
                    <Button Content="Edit" Click="OnEditTargetClick" Tag="{Binding}"/>
                    <Button Content="Delete" Classes="Danger" Click="OnDeleteTargetClick" Tag="{Binding}"/>
                  </StackPanel>
                </Grid>

                <!-- Endpoint row: tag / type / provider / URL (ellipsizes) / key state / ssh label -->
                <Grid ColumnDefinitions="auto,auto,auto,*,auto,auto" ColumnSpacing="8">
                  <Border Grid.Column="0" Theme="{DynamicResource TagBorder}" Padding="6,2" CornerRadius="4"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding Location, Converter={x:Static views:TargetEmojiConverter.Instance}}"
                                 FontFamily="Segoe UI Emoji, Apple Color Emoji" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Location, Converter={x:Static views:TargetNameConverter.Instance}}"
                                 Foreground="{Binding Location, Converter={x:Static views:TargetBrushConverter.Instance}}"
                                 FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{DynamicResource SemiColorText2}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Provider}" Foreground="{DynamicResource SemiColorText2}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Url}" Foreground="{DynamicResource SemiColorText2}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}"/>
                  <TextBlock Grid.Column="4" Text="{Binding ApiKeyConfigured, StringFormat='key: {0}'}"
                             Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding SshLabel}" Foreground="{DynamicResource SemiColorText2}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SshLabel}"/>
                </Grid>

                <!-- Effective values (READ-ONLY: no wire API persists them); wraps at narrow widths.
                     (WrapPanel has no Spacing property in Avalonia 12 — the chips carry their
                     own 12px inter-chip margin.) -->
                <WrapPanel>
                  <TextBlock Text="{Binding SpeedFactor, StringFormat='SpeedFactor: {0:0.###}'}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding MaxVramMB, StringFormat='MaxVramMB: {0}'}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding MaxParallel, StringFormat='MaxParallel: {0}'}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding EffectiveKeepAliveSeconds, StringFormat='KeepAlive: {0}s'}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding KeepAliveSource, StringFormat='({0})'}" Foreground="{DynamicResource SemiColorText2}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding PowerWatts, StringFormat='Power: {0:0.#} W'}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding HardwareHint}" Foreground="{DynamicResource SemiColorText2}" Margin="0,0,12,4"/>
                  <TextBlock Text="{Binding ResidentModels.Count, StringFormat='Resident: {0}'}"
                             ToolTip.Tip="Resident models" Margin="0,0,12,4"/>
                </WrapPanel>

                <!-- Declared models roster -->
                <TextBlock Text="{Binding ModelsCount, StringFormat='Declared models: {0}'}" Foreground="{DynamicResource SemiColorText2}"/>

                <!-- Hardware profile (always expanded — no Expander) -->
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding HardwareSource, StringFormat='Hardware profile ({0})'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding HardwareReachable, StringFormat='reachable: {0}'}"/>
                  <StackPanel Spacing="2" IsVisible="{Binding HasHardwareProfile}">
                    <TextBlock Text="{Binding HardwareOs}" Opacity="0.8"/>
                    <TextBlock Text="{Binding HardwareArchitecture}" Opacity="0.8"/>
                    <TextBlock Text="{Binding HardwareSystemRamMB, StringFormat='system RAM: {0} MB'}" Opacity="0.8"/>
                    <TextBlock Text="{Binding HardwareTotalFastMemoryMB, StringFormat='fast memory: {0} MB'}" Opacity="0.8"/>
                    <TextBlock Text="{Binding HardwareEffectiveBandwidthGBs, StringFormat='bandwidth: {0:0.##} GB/s'}" Opacity="0.8"/>
                    <ItemsControl ItemsSource="{Binding Gpus}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.8">
                            <TextBlock Text="{Binding Vendor}"/>
                            <TextBlock Text="{Binding ModelName}"/>
                            <TextBlock Text="{Binding VramMB, StringFormat='{}{0} MB'}"/>
                            <TextBlock Text="{Binding VramType}"/>
                            <TextBlock Text="{Binding BandwidthGBs, StringFormat='{}{0:0.##} GB/s'}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Text="no hardware profile yet" Foreground="{DynamicResource SemiColorText2}"
                             IsVisible="{Binding HasHardwareProfile, Converter={x:Static converters:BoolNegateConverter.Instance}}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
