<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OllamaRouter.App.Views"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             x:Class="OllamaRouter.App.Views.CartographyView"
             x:DataType="vm:CartographyViewModel">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>
      <Button Content="Refresh" Command="{Binding RefreshCommand}"/>

      <!-- Node header row (matrix columns, node order; Cloud pseudo-target last) -->
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Model" FontWeight="Bold" Width="260" VerticalAlignment="Center"/>
        <ItemsControl ItemsSource="{Binding Nodes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="4" Margin="2" Background="#1E2A38" CornerRadius="4" MinWidth="140">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Liveness}" Opacity="0.7"/>
                  <TextBlock Text="{Binding TotalLoadedVramBytes, StringFormat='{}{0} B loaded'}" Opacity="0.7"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Model x target matrix -->
      <ItemsControl ItemsSource="{Binding Models}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8" Padding="6" Background="#161B22" CornerRadius="6">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="260" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Architecture}" Opacity="0.8"/>
                    <TextBlock Text="{Binding WeightSizeHuman}" Opacity="0.8"/>
                    <TextBlock Text="{Binding Quantization, StringFormat='{}{0}'}" Opacity="0.6"/>
                    <TextBlock Text="{Binding NativeContextWindow, StringFormat='native {0}'}" Opacity="0.7"/>
                    <TextBlock Text="{Binding RecommendedContextWindow, StringFormat='rec {0}'}" Opacity="0.7"/>
                  </StackPanel>
                  <Button Content="Preload" Click="OnPreloadClick" Tag="{Binding}" HorizontalAlignment="Right"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="4" Margin="2" CornerRadius="4" MinWidth="140"
                              Background="{Binding Present, Converter={x:Static local:CellBackgroundConverter.Instance}}">
                        <StackPanel Spacing="1" ToolTip.Tip="{Binding Summary}">
                          <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Summary}" Opacity="0.75" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                          <TextBlock Text="{Binding ContextCeiling, StringFormat='ctx {0}'}" Opacity="0.6"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Resident processes -->
      <StackPanel Spacing="4">
        <TextBlock Text="Resident Model Processes" FontWeight="Bold" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding LoadedProcesses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="240,140,120,90,90,80,100" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Target}"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeVramBytes, StringFormat='{}{0} B'}"/>
                <TextBlock Grid.Column="3" Text="{Binding Quantization}" Opacity="0.7"/>
                <TextBlock Grid.Column="4" Text="{Binding ContextLength, TargetNullValue='-'}"/>
                <TextBlock Grid.Column="5" Text="{Binding Liveness}" Opacity="0.7"/>
                <TextBlock Grid.Column="6" Text="{Binding Stale, StringFormat='stale: {0}'}" Opacity="0.7"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
