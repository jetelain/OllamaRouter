<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OllamaRouter.App.Views.Dialogs.ConnectInstanceDialog"
        Title="Select Router Instance"
        Width="460" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Padding="20">
    <StackPanel Spacing="16">
      <TextBlock Text="Connect to OllamaRouter" FontSize="18" FontWeight="Bold" />

      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="10">
          <RadioButton Name="LocalRadio" Content="Local Daemon (http://localhost:11434)"
                       IsChecked="True" GroupName="InstanceType" />
          <RadioButton Name="RemoteRadio" Content="Remote Router Instance"
                       GroupName="InstanceType" />
        </StackPanel>
      </Border>

      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1"
              IsEnabled="{Binding #RemoteRadio.IsChecked}">
        <StackPanel Spacing="10">
          <TextBlock Text="Remote Instance Details" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
          <Border Padding="10,8"
                  CornerRadius="6"
                  Background="{DynamicResource NightCodeBgInput}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="Router URL:" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
              <TextBox Name="RemoteUrlBox" PlaceholderText="http://host:11434" Text="http://" />
            </StackPanel>
          </Border>
          <Border Padding="10,8"
                  CornerRadius="6"
                  Background="{DynamicResource NightCodeBgInput}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="API Key (session only):" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
              <TextBox Name="RemoteKeyBox" PasswordChar="•" PlaceholderText="Optional for unprotected routers" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
        <Button Content="Connect" Classes="Primary" Click="OnConnectClick" MinWidth="90" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
