<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OllamaRouter.App.Views.Dialogs.ConfirmDialog"
        Title="Confirm"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
      <Button Content="OK" Click="OnOkClick" MinWidth="90" />
    </StackPanel>
    <Border Padding="12"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <TextBlock x:Name="PART_Message" TextWrapping="Wrap" />
    </Border>
  </DockPanel>
</Window>
