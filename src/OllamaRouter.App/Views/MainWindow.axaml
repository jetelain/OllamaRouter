<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OllamaRouter.App.Views"
        xmlns:vm="using:OllamaRouter.App.ViewModels"
        xmlns:converters="using:OllamaRouter.App.Converters"
        x:Class="OllamaRouter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OllamaRouter"
        Icon="avares://ollamarouter-app/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:MonitorViewModel">
      <views:MonitorView/>
    </DataTemplate>
    <DataTemplate DataType="vm:AgentSessionsViewModel">
      <views:AgentSessionsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:FleetTargetsViewModel">
      <views:FleetTargetsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:CartographyViewModel">
      <views:CartographyView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- NightCodeForge surface-card branding header (task #170): app icon + two-tone
         Ollama/Router wordmark + the daemon status pill + the controls. -->
    <Border Grid.Row="0"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8,8,8,0"
            Padding="12,10">
      <StackPanel>
        <Grid ColumnDefinitions="auto,*,auto" VerticalAlignment="Center">
          <!-- Left: Title & Status -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="avares://ollamarouter-app/Assets/icon.ico" Width="28" Height="28"
                   VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Ollama" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="Router" FontSize="18" FontWeight="ExtraBold"
                         Foreground="{DynamicResource NightCodeAccentIndigoLightText}"/>
            </StackPanel>
            <Border Theme="{DynamicResource TagBorder}" Padding="8,3" CornerRadius="12">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Status dot (task #173): the fill follows the live daemon state —
                     green Running/Remote · amber Connecting/Port Conflict · crimson Stopped/Disconnected. -->
                <Ellipse Width="8" Height="8"
                         Fill="{Binding DaemonStatus, Converter={x:Static converters:DaemonStatusToBrushConverter.Instance}}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" MaxWidth="400"
                       Foreground="{DynamicResource SemiColorText2}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Right: Controls & Instance selector -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Refresh" Command="{Binding RefreshStatusCommand}"/>
            <Button Content="Start" Classes="Primary" Command="{Binding StartDaemonCommand}" IsVisible="{Binding ShowStartButton}"/>
            <Button Content="Stop" Classes="Danger" Command="{Binding StopDaemonCommand}" IsVisible="{Binding ShowStopButton}"/>
            <Button Content="Restart" Classes="Warning" Command="{Binding RestartDaemonCommand}" IsVisible="{Binding IsLocalMode}"/>
            <Button Content="🌐 Select Instance..." Click="OnSelectInstanceClick"/>
          </StackPanel>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Border>

    <!-- Tabs -->
    <TabControl Grid.Row="1"
                SelectedIndex="{Binding SelectedTabIndex}"
                Margin="6,4,6,6"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
      <TabItem Header="Monitor &amp; Savings" Content="{Binding MonitorTab}"/>
      <TabItem Header="Agents &amp; Sessions" Content="{Binding SessionsTab}"/>
      <TabItem Header="Fleet &amp; Cloud Targets" Content="{Binding FleetTab}"/>
      <TabItem Header="Model Cartography" Content="{Binding CartographyTab}"/>
      <TabItem Header="Settings &amp; API Keys" Content="{Binding SettingsTab}"/>
    </TabControl>
  </Grid>
</Window>
