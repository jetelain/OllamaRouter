<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OllamaRouter.App.Views"
        xmlns:vm="using:OllamaRouter.App.ViewModels"
        x:Class="OllamaRouter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OllamaRouter"
        Icon="avares://ollamarouter-app/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:MonitorViewModel">
      <views:MonitorView/>
    </DataTemplate>
    <DataTemplate DataType="vm:FleetTargetsViewModel">
      <views:FleetTargetsView/>
    </DataTemplate>
    <DataTemplate DataType="vm:CartographyViewModel">
      <views:CartographyView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- Modern Header / Connection bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid ColumnDefinitions="auto,*,auto" Margin="14,10" VerticalAlignment="Center">
          <!-- Left: Title & Status -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="OllamaRouter" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Theme="{DynamicResource TagBorder}" Padding="8,3" CornerRadius="12">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                  <Ellipse.Fill>
                    <SolidColorBrush Color="#3BA55C"/>
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" MaxWidth="400"
                       Foreground="{DynamicResource SemiColorText2}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Right: Controls & Instance selector -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Refresh" Command="{Binding RefreshStatusCommand}"/>
            <Button Content="Start" Classes="Primary" Command="{Binding StartDaemonCommand}" IsVisible="{Binding IsLocalMode}"/>
            <Button Content="Stop" Classes="Danger" Command="{Binding StopDaemonCommand}" IsVisible="{Binding IsLocalMode}"/>
            <Button Content="Restart" Classes="Warning" Command="{Binding RestartDaemonCommand}" IsVisible="{Binding IsLocalMode}"/>
            <Button Content="🌐 Select Instance..." Click="OnSelectInstanceClick"/>
          </StackPanel>
        </Grid>

        <!-- Loading indicator -->
        <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Border>

    <!-- Tabs -->
    <TabControl Grid.Row="1"
                SelectedIndex="{Binding SelectedTabIndex}"
                Margin="6,4,6,6"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
      <TabItem Header="Monitor &amp; Savings" Content="{Binding MonitorTab}"/>
      <TabItem Header="Fleet &amp; Cloud Targets" Content="{Binding FleetTab}"/>
      <TabItem Header="Model Cartography" Content="{Binding CartographyTab}"/>
      <TabItem Header="Settings &amp; API Keys" Content="{Binding SettingsTab}"/>
    </TabControl>
  </Grid>
</Window>
