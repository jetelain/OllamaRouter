<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels"
             x:Class="OllamaRouter.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer Padding="8">
    <StackPanel Spacing="14">
      <TextBlock Text="{Binding LastError}" Foreground="#FF7B7B" TextWrapping="Wrap" IsVisible="{Binding IsErrorVisible}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Load" Command="{Binding RefreshCommand}"/>
        <Button Content="Save Configuration" Classes="Primary" Command="{Binding SaveCommand}"/>
      </StackPanel>

      <!-- DynamicContext -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="Dynamic Context" FontWeight="Bold" FontSize="14"/>
          <Grid ColumnDefinitions="240,180" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding DynamicContext.Enabled}" Content="Enabled"/>
            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding DynamicContext.DenseClampEnabled}" Content="Dense clamp enabled"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto-shrink cooldown (turns):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DynamicContext.AutoShrinkCooldownTurns}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-shrink idle timeout (s):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DynamicContext.AutoShrinkIdleTimeoutSeconds}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Resilience -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="Resilience" FontWeight="Bold" FontSize="14"/>
          <Grid ColumnDefinitions="240,180" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Max consecutive failures (0 = disabled):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Resilience.MaxConsecutiveFailures}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Failures token tolerance (0 = exact match):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Resilience.ConsecutiveFailuresTokenTolerance}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Pricing -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="Pricing" FontWeight="Bold" FontSize="14"/>
          <Grid ColumnDefinitions="240,180" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Prompt price / 1M (blank = unset):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Pricing.PromptPricePerMillion}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Completion price / 1M (blank = unset):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Pricing.CompletionPricePerMillion}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Flat price / 1M (blank = unset):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Pricing.PricePerMillion}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Cached prompt price / 1M (blank = unset):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Pricing.CachedPromptPricePerMillion}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Currency:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Pricing.Currency}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Electricity price / kWh (blank = 0.20):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Pricing.ElectricityPricePerKwh}"/>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Default node power (W, blank = 150):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Pricing.DefaultNodePowerWatts}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Cloud -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="Cloud Overflow" FontWeight="Bold" FontSize="14"/>
          <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding Cloud.Enabled}" Content="Enabled"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Default model:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Cloud.DefaultModel}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Preferred relay target:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cloud.PreferredRelayTarget}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding Cloud.OverflowConfigured, StringFormat='Relay sign-in configured: {0}'}" Foreground="{DynamicResource SemiColorText2}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ApiSecurity (read-only; NOT part of the PUT body) -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="API Security (read-only)" FontWeight="Bold" FontSize="14"/>
          <TextBlock Text="{Binding RequireKeyForAllEndpoints, StringFormat='requireKeyForAllEndpoints: {0}'}" Foreground="{DynamicResource SemiColorText2}"/>
          <TextBlock Text="{Binding DefaultKeyRotationHours, StringFormat='defaultKeyRotationHours: {0}'}" Foreground="{DynamicResource SemiColorText2}"/>
        </StackPanel>
      </Border>

      <!-- API keys -->
      <Border Padding="12" Theme="{DynamicResource CardBorder}">
        <StackPanel Spacing="6">
          <TextBlock Text="Router API Keys" FontWeight="Bold" FontSize="14"/>
          <ItemsControl ItemsSource="{Binding ApiKeys}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="220,220,*,auto" Margin="0,2" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                  <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" Foreground="{DynamicResource SemiColorText2}"/>
                  <TextBlock Grid.Column="2" Text="{Binding ExpiresAt, StringFormat='expires {0}', TargetNullValue='no expiry'}" Foreground="{DynamicResource SemiColorText2}"/>
                  <Button Grid.Column="3" Content="Delete" Classes="Danger" Click="OnDeleteKeyClick" Tag="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding CreateKeyName}" Watermark="key name" Width="200"/>
            <TextBox Text="{Binding CreateKeyHours}" Watermark="valid for (h, blank = none)" Width="180"/>
            <Button Content="Create Key" Classes="Primary" Command="{Binding CreateKeyCommand}"/>
            <Button Content="Rotate Default Key" Classes="Warning" Click="OnRotateDefaultKeyClick"/>
          </StackPanel>

          <!-- One-time created-key panel -->
          <Border Background="#2A1E1E" Padding="8" CornerRadius="6" IsVisible="{Binding IsCreatedKeyPanelVisible}">
            <StackPanel Spacing="4">
            <TextBlock Text="{Binding CreatedKeyName, StringFormat='NEW key {0} — shown EXACTLY ONCE (only its hash is persisted):'}"
                       FontWeight="Bold" Foreground="#FFD28A"/>
            <TextBox Text="{Binding CreatedKey, Mode=OneWay}" IsReadOnly="True" FontFamily="monospace"/>
            </StackPanel>
          </Border>

          <!-- One-time rotated-key panel -->
          <Border Background="#2A1E1E" Padding="8" CornerRadius="6" IsVisible="{Binding IsRotatedKeyPanelVisible}">
            <StackPanel Spacing="4">
            <TextBlock Text="NEW default key — shown EXACTLY ONCE; the PREVIOUS key stopped working IMMEDIATELY (no grace period). "
                       FontSize="13" Foreground="#FFD28A" TextWrapping="Wrap"/>
            <TextBox Text="{Binding RotatedKey, Mode=OneWay}" IsReadOnly="True" FontFamily="monospace"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
