<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardTargetsStepView"
             x:DataType="vm:WizardTargetsStepViewModel">
  <ScrollViewer Padding="12">
    <StackPanel Spacing="12">
      <TextBlock Text="Step 2 — Fleet Targets" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap"
                 Text="Add your local node, LAN nodes and cloud providers. Liveness is probed live every 2 seconds."/>

      <!-- Live fleet rows -->
      <Border Padding="8" CornerRadius="6" Background="#1E1E2A">
        <StackPanel Spacing="4">
          <TextBlock Text="Current fleet" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WizardTargetRow">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                  <TextBlock Text="{Binding Name}" Width="150" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Url}" Width="230" Foreground="#9AA0B5"/>
                  <TextBlock Text="{Binding Liveness}" Width="80"/>
                  <TextBlock Text="enabled" IsVisible="{Binding Enabled}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Cloud overflow -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <CheckBox IsChecked="{Binding CloudEnabled}" Content="Cloud overflow (ollama.com, no API key)" VerticalAlignment="Center"/>
        <Button Content="Toggle Cloud" Command="{Binding ToggleCloudCommand}"/>
      </StackPanel>

      <!-- Local node -->
      <Button Content="Add Local node (http://127.0.0.1:11435)" Command="{Binding AddLocalCommand}"/>

      <!-- Remote / OpenAI-compatible providers -->
      <TextBlock Text="Remote / OpenAI-compatible providers:" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="OpenRouter" Command="{Binding UseOpenRouterCommand}"/>
        <Button Content="Groq" Command="{Binding UseGroqCommand}"/>
        <Button Content="OpenAI" Command="{Binding UseOpenAiCommand}"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding RemoteName}" Watermark="Name" Width="150"/>
          <TextBox Text="{Binding RemoteUrl}" Watermark="http://host:port" Width="260"/>
          <TextBox Text="{Binding RemoteApiKey}" PasswordChar="•" Watermark="API key" Width="200"/>
        </StackPanel>
        <Button Content="Add remote target" Command="{Binding AddRemoteCommand}"/>
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8BC34A"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
