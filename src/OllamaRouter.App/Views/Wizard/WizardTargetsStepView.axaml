<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:OllamaRouter.App.Converters"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardTargetsStepView"
             x:DataType="vm:WizardTargetsStepViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">

      <!-- Header Card -->
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Fleet Targets" FontSize="15" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource SemiColorText2}"
                       Text="The Local node (http://127.0.0.1:11435) is added automatically when entering this step. Liveness is probed every 2 seconds." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="Add Ollama Node" Classes="Primary" IsEnabled="{Binding !IsBusy}" Click="OnAddOllamaNodeClick" />
            <Button Content="Add Provider" IsEnabled="{Binding !IsBusy}" Click="OnAddProviderClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Fleet Table Card -->
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="1.1*,2*,1.4*,0.8*,0.8*,0.8*,0.6*" ColumnSpacing="10" Margin="8,0">
            <TextBlock Grid.Column="0" Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="1" Text="URL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="2" Text="GPU" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="3" Text="VRAM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="4" Text="Bandwidth" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="5" Text="Liveness" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Column="6" Text="Enabled" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText2}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WizardTargetRow">
                <Border Padding="8,7"
                        Margin="0,0,0,6"
                        CornerRadius="6"
                        Background="{DynamicResource NightCodeBgInput}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="1.1*,2*,1.4*,0.8*,0.8*,0.8*,0.6*" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="{DynamicResource SemiColorText2}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding GpuName}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GpuName}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding VramText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding BandwidthText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Liveness}" FontWeight="SemiBold"
                               Foreground="{Binding Liveness, Converter={x:Static conv:LivenessToBrushConverter.Instance}}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="enabled" IsVisible="{Binding Enabled}"
                               Foreground="{DynamicResource SemiColorSuccess}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock IsVisible="{Binding HasNoRows}"
                     Text="No fleet targets detected yet. Ensure the router daemon is running or add an Ollama node / external provider."
                     FontSize="12"
                     Foreground="{DynamicResource SemiColorText2}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

      <Border IsVisible="{Binding HasMessage}"
              Padding="10,8"
              CornerRadius="6"
              Background="{Binding MessageIsError, Converter={x:Static conv:BoolToBannerBackgroundConverter.Instance}}"
              BorderBrush="{Binding MessageIsError, Converter={x:Static conv:BoolToBannerBorderConverter.Instance}}"
              BorderThickness="1">
        <TextBlock Text="{Binding Message}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{Binding MessageIsError, Converter={x:Static conv:BoolToMessageForegroundConverter.Instance}}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
