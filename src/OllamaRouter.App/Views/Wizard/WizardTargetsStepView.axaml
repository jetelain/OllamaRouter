<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardTargetsStepView"
             x:DataType="vm:WizardTargetsStepViewModel">
  <ScrollViewer Padding="12">
    <StackPanel Spacing="12">
      <TextBlock Text="Step 2 — Fleet Targets" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap"
                 Text="The Local node (http://127.0.0.1:11435) is added automatically when you enter this step. Liveness is probed live every 2 seconds; add nodes and providers with the main app's dedicated dialogs below."/>

      <!-- Fleet table: header row + live rows (task #151 — hardware columns; the Cloud
           pseudo-target is excluded by the view model). Fixed column widths tuned so a row
           fits the 860 px window minimum without page-level horizontal scroll: declared
           columns 120+200+140+80+80+70+60 = 750 px + 6×10 spacing + 16 border padding +
           24 scroll padding = 850 px ≤ 860 px (the 60 px rightmost column — bold "Enabled" —
           needs ≈52–54 px at 14 px text; task #165). -->
      <Border Padding="8" CornerRadius="6" Background="#1E1E2A">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Name" Width="120" FontWeight="Bold"/>
            <TextBlock Text="URL" Width="200" FontWeight="Bold"/>
            <TextBlock Text="GPU" Width="140" FontWeight="Bold"/>
            <TextBlock Text="VRAM" Width="80" FontWeight="Bold"/>
            <TextBlock Text="Bandwidth" Width="80" FontWeight="Bold"/>
            <TextBlock Text="Liveness" Width="70" FontWeight="Bold"/>
            <TextBlock Text="Enabled" Width="60" FontWeight="Bold"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WizardTargetRow">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                  <TextBlock Text="{Binding Name}" Width="120" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                  <TextBlock Text="{Binding Url}" Width="200" Foreground="#9AA0B5"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}"/>
                  <TextBlock Text="{Binding GpuName}" Width="140"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GpuName}"/>
                  <TextBlock Text="{Binding VramText}" Width="80"/>
                  <TextBlock Text="{Binding BandwidthText}" Width="80"/>
                  <TextBlock Text="{Binding Liveness}" Width="70"/>
                  <TextBlock Text="enabled" Width="60" IsVisible="{Binding Enabled}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- The main app's dedicated add dialogs (task #149 windows/forms, task #151 reuse):
           Click handlers, no Command binding — modal ownership needs the Window top level,
           which only the view can resolve (WizardDialogLauncher). -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Add Ollama Node" Click="OnAddOllamaNodeClick"/>
        <Button Content="Add Provider" Click="OnAddProviderClick"/>
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8BC34A"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
