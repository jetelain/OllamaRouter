<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:OllamaRouter.App.Converters"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardEnvironmentStepView"
             x:DataType="vm:WizardEnvironmentStepViewModel">
  <ScrollViewer Padding="12">
    <StackPanel Spacing="12">
      <TextBlock Text="Step 1 — Local Ollama for the Router" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap"
                 Text="Install, start and update Ollama with one click, keep it on :11435, and run ollamarouter-server on :11434."/>

      <!-- Section 1: Ollama — the detection state drives which actions are visible (task #150). -->
      <Border Padding="10" CornerRadius="6" Background="#1E1E2A">
        <StackPanel Spacing="6">
          <TextBlock Text="Ollama" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="{Binding DetectionText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="✓ Ollama is running" FontWeight="Bold" Foreground="#8BC34A"
                     IsVisible="{Binding ShowRunningCheck}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Install Ollama" IsVisible="{Binding ShowInstallButton}" Command="{Binding InstallOllamaCommand}"/>
            <Button Content="Start Ollama" IsVisible="{Binding ShowStartButton}" Command="{Binding StartOllamaCommand}"/>
            <Button Content="Update Ollama" IsVisible="{Binding ShowUpdateButton}" Command="{Binding UpdateOllamaCommand}"/>
            <Button Content="Re-check" Command="{Binding RecheckCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Section 2: Configuration for router — unified row grid (task #160). -->
      <Border Padding="10" CornerRadius="6" Background="#1E1E2A">
        <StackPanel Spacing="6">
          <TextBlock Text="Configuration for router" FontSize="15" FontWeight="Bold"/>
          <!-- Row 1: LAN exposure (hidden on Linux + when Ollama is not installed). -->
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowLanRow}">
            <TextBlock Grid.Column="0" Text="{Binding LanRowLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{Binding LanToggleText}" Command="{Binding ToggleLanCommand}"
                    IsVisible="{Binding ShowLanToggle}" VerticalAlignment="Center"/>
          </Grid>
          <!-- Row 2: effective Ollama port (✓ when Ok / Change port when WrongPort / nothing else). -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding OllamaPortLabel}" Foreground="#8BC34A" FontWeight="Bold"
                         TextWrapping="Wrap" IsVisible="{Binding ShowPortOk}"/>
              <TextBlock Text="{Binding OllamaPortLabel}" Foreground="#FFB74D"
                         TextWrapping="Wrap" IsVisible="{Binding ShowPortWrong}"/>
              <TextBlock Text="{Binding OllamaPortLabel}" Foreground="#9E9E9E"
                         TextWrapping="Wrap" IsVisible="{Binding ShowPortNotRunning}"/>
              <TextBlock Text="{Binding OllamaPortLabel}" Foreground="#9E9E9E"
                         TextWrapping="Wrap" IsVisible="{Binding ShowPortNotDetected}"/>
              <TextBlock Text="{Binding OllamaPortLabel}" Foreground="#9E9E9E"
                         TextWrapping="Wrap" IsVisible="{Binding ShowPortUnknown}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Foreground="#8BC34A"
                       IsVisible="{Binding ShowPortOk}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Change port" Command="{Binding ChangePortCommand}"
                    IsVisible="{Binding ShowChangePortButton}" VerticalAlignment="Center"/>
          </Grid>
          <!-- Row 3: router :11434 (✓ when running / Start router when free / nothing else). -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding RouterStatusLabel}" FontWeight="Bold"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" Foreground="#8BC34A"
                       IsVisible="{Binding ShowRouterRunningCheck}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Start router" Command="{Binding StartRouterCommand}"
                    IsVisible="{Binding ShowStartRouterButton}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Linux: Install/Update are one-click above; start + the port stay manual (task #150, M1). -->
      <Border Padding="10" CornerRadius="6" Background="#2A2A1E" IsVisible="{Binding IsLinux}">
        <StackPanel Spacing="4">
          <TextBlock Text="Linux: install and update are one-click above; on Linux, start Ollama and set the port manually:"
                     FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="export OLLAMA_HOST=127.0.0.1:11435" FontFamily="monospace"/>
          <TextBlock Text="export OLLAMA_FLASH_ATTENTION=1" FontFamily="monospace"/>
          <TextBlock Text="export OLLAMA_KV_CACHE_TYPE=q8_0" FontFamily="monospace"/>
          <TextBlock Text="ollama serve   # then: ollamarouter start" FontFamily="monospace"/>
        </StackPanel>
      </Border>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                 Foreground="{Binding MessageIsError, Converter={x:Static conv:BoolToMessageForegroundConverter.Instance}}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
