<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:OllamaRouter.App.Converters"
        xmlns:views="using:OllamaRouter.App.Views.Wizard"
        xmlns:wvm="using:OllamaRouter.App.ViewModels.Wizard"
        x:Class="OllamaRouter.App.Views.Wizard.SetupWizardWindow"
        x:DataType="wvm:SetupWizardViewModel"
        Title="OllamaRouter Setup"
        Icon="avares://ollamarouter-app/Assets/icon.ico"
        Width="1020" Height="700"
        MinWidth="860" MinHeight="560">
  <DockPanel>
    <!-- Task #150: branding header (OllamaRouter name + logo) — Setup Wizard window ONLY,
         docked ABOVE the step strip (the main app window is untouched). -->
    <Border DockPanel.Dock="Top" Padding="12,8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="avares://ollamarouter-app/Assets/icon.ico" Width="28" Height="28"/>
        <TextBlock Text="OllamaRouter" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <!-- 5-step progress header (task #151): all titles visible, the active step is bold -->
    <Border DockPanel.Dock="Top" Padding="12,10"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="1 · Local Ollama"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=0}"/>
        <TextBlock Text="2 · Fleet Targets"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=1}"/>
        <TextBlock Text="3 · Cloud &amp; Providers"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=2}"/>
        <TextBlock Text="4 · Micro-Benchmark"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=3}"/>
        <TextBlock Text="5 · Recommendations"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=4}"/>
      </StackPanel>
    </Border>

    <!-- Bottom navigation bar (Finish is the only hard gate) -->
    <Border DockPanel.Dock="Bottom" Padding="12,10"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}"/>
        <Button Content="Next" Classes="Primary" Command="{Binding NextCommand}"/>
        <Button Content="Finish" Classes="Primary" Command="{Binding FinishCommand}"/>
      </StackPanel>
    </Border>

    <!-- Step body: all five overlap (task #151); visibility driven by SelectedStep -->
    <Grid>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=0}">
        <views:WizardEnvironmentStepView DataContext="{Binding EnvironmentStep}"/>
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=1}">
        <views:WizardTargetsStepView DataContext="{Binding TargetsStep}"/>
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=2}">
        <views:WizardCloudStepView DataContext="{Binding CloudStep}"/>
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=3}">
        <views:WizardBenchmarkStepView DataContext="{Binding BenchmarkStep}"/>
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=4}">
        <views:WizardRecommendationsStepView DataContext="{Binding RecommendationsStep}"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
