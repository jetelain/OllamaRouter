<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:OllamaRouter.App.Converters"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardBenchmarkStepView"
             x:DataType="vm:WizardBenchmarkStepViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">

      <!-- Header & Progress Card -->
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Micro-Benchmark" FontSize="15" FontWeight="SemiBold" />
              <TextBlock TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="{DynamicResource SemiColorText2}"
                         Text="Benchmark the selected candidate models on every active node. A context is viable at 20 tokens/s or faster; models marked as not fitting start unchecked." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="Run benchmarks" Classes="Primary" Command="{Binding RunBenchmarksCommand}" />
              <Button Content="Clear results" Command="{Binding ClearResultsCommand}" />
            </StackPanel>
          </Grid>

          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" />
          <TextBlock Text="{Binding ProgressSummaryText}"
                     FontSize="11"
                     Foreground="{DynamicResource SemiColorText2}"
                     IsVisible="{Binding HasBenchmarkRows}" />
        </StackPanel>
      </Border>

      <!-- Candidate Models Card -->
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Text="Candidate models" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Select fitting" Command="{Binding SelectFittingOnlyCommand}" />
              <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding CandidateGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BenchmarkCandidateGroupRow">
                <Border Padding="10,8"
                        Margin="0,0,0,8"
                        CornerRadius="6"
                        Background="{DynamicResource NightCodeBgInput}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Foreground="{DynamicResource NightCodeAccentIndigoLightText}" />
                      <TextBlock Text="{Binding GpuName}" Foreground="{DynamicResource SemiColorText1}" />
                      <TextBlock Text="{Binding VramText}" Foreground="{DynamicResource SemiColorText2}" />
                      <TextBlock Text="{Binding BandwidthText}" Foreground="{DynamicResource SemiColorText2}" />
                      <TextBlock Text="{Binding Note}" Foreground="{DynamicResource NightCodeAccentAmber}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Models}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BenchmarkCandidateRow">
                          <StackPanel Spacing="1" Margin="8,2,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Model}" Width="160" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding ClassText}" Foreground="{DynamicResource SemiColorText2}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0">
                              <TextBlock Text="{Binding RolesText}" Width="260" FontSize="12" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding FitText}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{Binding FitText, Converter={x:Static conv:FitTextToBrushConverter.Instance}}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Two-Column Run Status & Results Split (mirrors NCF Installer Step 2/3) -->
      <Grid ColumnDefinitions="1*,2*" ColumnSpacing="12">
        <Border Grid.Column="0"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource NightCodeBgSurface}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="Run status" FontSize="14" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding BenchmarkRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkRow">
                  <Border Padding="8,6"
                          Margin="0,0,0,6"
                          CornerRadius="6"
                          Background="{DynamicResource NightCodeBgInput}"
                          BorderBrush="{DynamicResource SemiColorBorder}"
                          BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding Target}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource NightCodeBgSurface}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="Results (per model × context)" FontSize="14" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ResultRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkResultRow">
                  <Border Padding="8,6"
                          Margin="0,0,0,6"
                          CornerRadius="6"
                          Background="{DynamicResource NightCodeBgInput}"
                          BorderBrush="{DynamicResource SemiColorBorder}"
                          BorderThickness="1">
                    <Grid ColumnDefinitions="0.9*,1.2*,1.1*,0.7*,0.8*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding Target}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Role}" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding ContextText}" />
                      <TextBlock Grid.Column="4" Text="{Binding ThroughputText}" FontWeight="SemiBold" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="viable" Foreground="{DynamicResource SemiColorSuccess}" FontWeight="SemiBold" IsVisible="{Binding Viable}" />
                        <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource NightCodeAccentCrimsonLightText}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

      <Border IsVisible="{Binding HasMessage}"
              Padding="10,8"
              CornerRadius="6"
              Background="{DynamicResource SemiColorSuccessLight}"
              BorderBrush="{DynamicResource SemiColorSuccess}"
              BorderThickness="1">
        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorSuccess}" />
      </Border>

      <Border IsVisible="{Binding HasError}"
              Padding="10,8"
              CornerRadius="6"
              Background="{DynamicResource SemiColorDangerLight}"
              BorderBrush="{DynamicResource SemiColorDanger}"
              BorderThickness="1">
        <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource NightCodeAccentCrimsonLightText}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
