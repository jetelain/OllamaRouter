<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels.Wizard"
             x:Class="OllamaRouter.App.Views.Wizard.WizardBenchmarkStepView"
             x:DataType="vm:WizardBenchmarkStepViewModel">
  <ScrollViewer Padding="12">
    <StackPanel Spacing="12">
      <TextBlock Text="Step 4 — Micro-Benchmark" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap"
                 Text="Benchmark the selected candidate models on every active node. A context is viable when it decodes at 20 tokens/s or faster. Unchecking a model skips it for the next run only — a fresh step entry selects all again."/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Run benchmarks" Command="{Binding RunBenchmarksCommand}"/>
        <Button Content="Clear results" Command="{Binding ClearResultsCommand}"/>
      </StackPanel>

      <!-- Candidate models grouped by target (task #152): the per-target hardware + the
           full candidate set with per-model fit verdicts + the run-scoped opt-out. -->
      <TextBlock Text="Candidate models" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding CandidateGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BenchmarkCandidateGroupRow">
            <StackPanel Spacing="2" Margin="0,2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Target}" Width="130" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GpuName}" Width="220"/>
                <TextBlock Text="{Binding VramText}" Width="150"/>
                <TextBlock Text="{Binding BandwidthText}" Width="150"/>
                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource NightCodeAccentAmber}"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Models}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BenchmarkCandidateRow">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,1,0,1">
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Model}" Width="150" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding RolesText}" Width="150" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding FitText}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Run status per target -->
      <TextBlock Text="Run status" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding BenchmarkRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BenchmarkRow">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
              <TextBlock Text="{Binding Target}" Width="130" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding StatusText}" Width="120"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Per-context results -->
      <TextBlock Text="Results (per model × context)" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding ResultRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BenchmarkResultRow">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
              <TextBlock Text="{Binding Target}" Width="110"/>
              <TextBlock Text="{Binding Model}" Width="150"/>
              <TextBlock Text="{Binding Role}" Width="150"/>
              <TextBlock Text="{Binding ContextText}" Width="90"/>
              <TextBlock Text="{Binding ThroughputText}" Width="100"/>
              <TextBlock Text="viable" Foreground="{DynamicResource SemiColorSuccess}" IsVisible="{Binding Viable}"/>
              <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource NightCodeAccentCrimsonLightText}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorSuccess}"/>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource NightCodeAccentCrimsonLightText}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
