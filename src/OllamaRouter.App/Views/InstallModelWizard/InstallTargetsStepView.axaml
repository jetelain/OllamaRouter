<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OllamaRouter.App.ViewModels.InstallModelWizard"
             x:Class="OllamaRouter.App.Views.InstallModelWizard.InstallTargetsStepView"
             x:DataType="vm:InstallTargetsStepViewModel">
  <ScrollViewer Padding="12">
    <StackPanel Spacing="12">
      <TextBlock Text="Step 2 — Targets" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap"
                 Text="Select the fleet targets to install the model on. Pullable targets are Ollama-protocol nodes (the Ollama daemon pulls from the registry); non-Ollama targets are shown disabled."/>

      <TextBlock Text="{Binding NextGateHint}" Foreground="#FFC107" IsVisible="{Binding NextGateHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetching}" Height="4"/>
      <TextBlock Text="{Binding Error}" Foreground="#FF7B7B" TextWrapping="Wrap"/>

      <!-- Target rows -->
      <Border Padding="8" CornerRadius="6" Background="#1E1E2A">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallTargetRowVm">
              <Border Padding="8,6" CornerRadius="4" Margin="0,2" Background="#252536">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Pullable}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Width="140" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Liveness}" Width="70" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HardwareText}" Foreground="{DynamicResource SemiColorText2}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding HardwareText}"/>
                    <Border Theme="{DynamicResource TagBorder}" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                            IsVisible="{Binding Present}">
                      <TextBlock Text="already present" FontSize="11"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Note}" Foreground="#FF7B7B" FontSize="11"
                             IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <!-- BOTH modes (unified by task #131): the per-target quant/tag + context
                       inputs + the per-target alias hint chip + the suggestion (assisted). -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Pullable}">
                    <TextBox Text="{Binding QuantTag}" Width="120" Watermark="e.g. q4_K_M"/>
                    <TextBox Text="{Binding Context}" Width="110" Watermark="context (tokens)"/>
                    <Border Theme="{DynamicResource TagBorder}" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                            IsVisible="{Binding AliasHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding AliasHint, StringFormat='alias: {0}'}" FontSize="11"/>
                    </Border>
                    <Border Theme="{DynamicResource TagBorder}" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                            IsVisible="{Binding SuggestionBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding SuggestionBadge}" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{Binding SuggestionProvenance}" Foreground="{DynamicResource SemiColorText2}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding SuggestionProvenance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ModelRefError}" Foreground="#FF7B7B" FontSize="11" TextWrapping="Wrap"
                             IsVisible="{Binding ModelRefError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- BOTH modes (unified by task #131): the alias switch; every selected target is
           pulled with its OWN quant/tag + context (the per-row alias chip shows the
           computed alias while the switch is ON). -->
      <StackPanel Spacing="6">
        <CheckBox IsChecked="{Binding CreateAlias}" Content="Create context alias" VerticalAlignment="Center"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" FontSize="11"
                   Text="each selected target is pulled with its own quant/tag and context; the context alias is created per target"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
