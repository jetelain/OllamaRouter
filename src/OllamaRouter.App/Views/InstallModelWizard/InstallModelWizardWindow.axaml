<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:OllamaRouter.App.Converters"
        xmlns:views="using:OllamaRouter.App.Views.InstallModelWizard"
        xmlns:wvm="using:OllamaRouter.App.ViewModels.InstallModelWizard"
        x:Class="OllamaRouter.App.Views.InstallModelWizard.InstallModelWizardWindow"
        x:DataType="wvm:InstallModelWizardViewModel"
        Title="Install Model"
        Width="940" Height="640"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18" RowSpacing="12">

    <!-- Branding Header Card (NightCodeForge Installer shell parity) -->
    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Image Grid.Column="0"
               Source="avares://ollamarouter-app/Assets/icon.ico"
               Width="30"
               Height="30"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <TextBlock Text="Ollama" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Router" FontSize="18" FontWeight="ExtraBold"
                       Foreground="{DynamicResource NightCodeAccentIndigoLightText}" />
          </StackPanel>
          <TextBlock Text="Install a model onto fleet targets"
                     FontSize="11"
                     Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
        <Border Grid.Column="2"
                Padding="10,4"
                CornerRadius="6"
                Background="{DynamicResource NightCodeBgInput}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                VerticalAlignment="Center"
                IsVisible="{Binding ModelStep.ModelReference, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ModelStep.ModelReference}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SemiColorText1}" />
        </Border>
      </Grid>
    </Border>

    <!-- 3-Step Progress Indicator -->
    <Border Grid.Row="1"
            Padding="14,10"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
        <TextBlock Text="1 · Model"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=0}"
                   Foreground="{Binding SelectedStep, Converter={x:Static conv:WizardStepForegroundConverter.Instance}, ConverterParameter=0}" />
        <TextBlock Text="2 · Targets"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=1}"
                   Foreground="{Binding SelectedStep, Converter={x:Static conv:WizardStepForegroundConverter.Instance}, ConverterParameter=1}" />
        <TextBlock Text="3 · Review &amp; Install"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=2}"
                   Foreground="{Binding SelectedStep, Converter={x:Static conv:WizardStepForegroundConverter.Instance}, ConverterParameter=2}" />
      </StackPanel>
    </Border>

    <!-- Step Content Panels -->
    <Grid Grid.Row="2">
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=0}">
        <views:InstallModelStepView DataContext="{Binding ModelStep}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=1}">
        <views:InstallTargetsStepView DataContext="{Binding TargetsStep}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=2}">
        <views:InstallReviewStepView DataContext="{Binding ReviewStep}" />
      </Border>
    </Grid>

    <!-- Navigation Footer Card -->
    <Border Grid.Row="3"
            Padding="12,10"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="Install Model Wizard"
                   FontSize="12"
                   Foreground="{DynamicResource SemiColorText2}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Back" Command="{Binding BackCommand}" />
          <Button Content="Next" Classes="Primary" Command="{Binding NextCommand}" />
          <Button Content="Install" Command="{Binding ReviewStep.InstallCommand}" Classes="Primary"
                  IsVisible="{Binding ReviewStep.IsRunning, Converter={x:Static conv:BoolNegateConverter.Instance}}" />
          <Button Content="Cancel install" Classes="Danger" Command="{Binding ReviewStep.CancelInstallCommand}"
                  IsVisible="{Binding ReviewStep.IsRunning}" />
          <Button Content="Done" Command="{Binding DoneCommand}" Classes="Primary"
                  IsVisible="{Binding ReviewStep.RunCompleted}" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
