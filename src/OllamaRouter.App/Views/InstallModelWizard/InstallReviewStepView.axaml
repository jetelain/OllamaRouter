<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:OllamaRouter.App.Converters"
             xmlns:vm="using:OllamaRouter.App.ViewModels.InstallModelWizard"
             x:Class="OllamaRouter.App.Views.InstallModelWizard.InstallReviewStepView"
             x:DataType="vm:InstallReviewStepViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">

      <!-- Step Intro Card -->
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="Review &amp; Install" FontSize="15" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="{DynamicResource SemiColorText2}"
                     Text="Review the install plan, then install. Targets run SEQUENTIALLY (one at a time); a failure on one target does not stop the remaining ones. Cancel aborts the in-flight pull." />
        </StackPanel>
      </Border>

      <!-- Task #174: the opt-in post-install micro-benchmark toggle (mirrors Step 2's
           alias-switch framing) -->
      <Border Padding="10,8"
              CornerRadius="6"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding RunBenchmarkAfterInstall}" VerticalAlignment="Center">
            <TextBlock Text="Run micro-benchmark after install" />
          </CheckBox>
          <TextBlock TextWrapping="Wrap"
                     FontSize="11"
                     Foreground="{DynamicResource SemiColorText2}"
                     Text="each successfully installed target is micro-benchmarked after install — live progress per target, takes several minutes per model" />
        </StackPanel>
      </Border>

      <!-- Per-target run rows -->
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InstallRunRowVm">
            <Border Padding="8,6" CornerRadius="6" Margin="0,2" Background="{DynamicResource NightCodeBgSurface}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Target}" Width="140" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.85" />
                  <TextBlock Text="{Binding StatusText}" Width="230" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
                <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="6"
                             IsIndeterminate="{Binding ProgressIndeterminate}" />
                <!-- Task #174: the opt-in post-install micro-benchmark feedback (live phase
                     message + slim fractional bar + terminal summary) -->
                <TextBlock Text="{Binding BenchmarkNote}"
                           Foreground="{DynamicResource NightCodeAccentIndigoLightText}" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding HasBenchmarkNote}" />
                <ProgressBar Value="{Binding BenchmarkProgressValue}" Minimum="0" Maximum="100" Height="4"
                             IsIndeterminate="{Binding BenchmarkProgressIndeterminate}"
                             IsVisible="{Binding HasBenchmarkProgress}" />
                <TextBlock Text="{Binding BenchmarkSummaryText}"
                           Foreground="{DynamicResource SemiColorText2}" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding HasBenchmarkSummary}" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NightCodeAccentCrimsonLightText}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Overall run result (dual-severity banner: Succeeded = success,
           Partial / Failed / Cancelled = danger) -->
      <Border Padding="10,8"
              CornerRadius="6"
              Background="{Binding RunResultIsError, Converter={x:Static conv:BoolToBannerBackgroundConverter.Instance}}"
              BorderBrush="{Binding RunResultIsError, Converter={x:Static conv:BoolToBannerBorderConverter.Instance}}"
              BorderThickness="1"
              IsVisible="{Binding HasRunResult}">
        <TextBlock Text="{Binding RunResultText, StringFormat='Result: {0}'}"
                   FontWeight="Bold" FontSize="14"
                   Foreground="{Binding RunResultIsError, Converter={x:Static conv:BoolToMessageForegroundConverter.Instance}}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
