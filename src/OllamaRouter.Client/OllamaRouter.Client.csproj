<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>OllamaRouter.Client</RootNamespace>
    <Description>
      Shared OllamaRouter client SDK (task #98): the /api/router/* + /monitor/api wire DTOs,
      the local default-key reader factory (OllamaRouterDefaultKeyReader over
      Pmad.LocalApi.Security) and the strongly-typed management/monitoring HTTP client.
      Leaf SDK: no ASP.NET Core, no YARP; only Pmad.LocalApi.Security (transitively
      Microsoft.Extensions.Logging.Abstractions) — AOT/trim-safe for CLI and desktop
      (Avalonia) consumers.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Task #115: shared local API-key security primitives (IKeyProtector / PlainKeyProtector /
         DpapiKeyProtector, SecretFilePermissions, IDefaultKeyReader / DefaultKeyReader) — the
         in-tree copies of the client SDK and the server were replaced by this package. net10.0,
         IsTrimmable / Native AOT-safe (source-generated JSON, DPAPI behind an IsWindows guard);
         transitively adds only Microsoft.Extensions.Logging.Abstractions +
         System.Security.Cryptography.ProtectedData 10.0.5. -->
    <PackageReference Include="Pmad.LocalApi.Security" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OllamaRouter.Tests" />
  </ItemGroup>

</Project>
