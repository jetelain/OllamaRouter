<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OllamaRouter.E2ETests</RootNamespace>
    <AssemblyName>OllamaRouter.E2ETests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Task #111: kept in lockstep with src/OllamaRouter (5.5.2) so the E2E suite speaks the
         same OllamaSharp version as the router's native dispatch client. -->
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
  </ItemGroup>

</Project>
