{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "OllamaRouter": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Factory defaults — read-only. User settings belong in config/config.json next to the
  // executable (created by the Setup API or manually). This file is never modified at runtime.
  "OllamaRouter": {
    "BindAddress": "http://+:11434/",

    // Worst-case margin above the estimator (incl. chat-template overhead). Measured residual
    // error is within ~±10% once the recorded payload text (incl. "reasoning") is fully counted.
    "TokenEstimationOverheadFactor": 1.025,

    // Estimator strategy: "Heuristic" (default, fast, zero memory footprint, saves ~24MB RAM) or "Tiktoken" (cl100k_base)
    "TokenEstimator": "Heuristic",

    // Additive reasoning-fit margin (in tokens) added to prompt estimate before qualifying a target.
    // Default 8192 (recommend 10240 for long-thinking agent models).
    "ContextFitMarginTokens": 8192,

    // When true and all enabled fleet targets fail Stage-1 context qualification,
    // the router dispatches the request to the online, capable target with the largest context
    // capacity (Max CMax) rather than rejecting with a 503 error.
    "DispatchToLargestCapacityOnOverflow": true,

    // Optional recording mode to investigate estimated vs actual token counts: appends each inference
    // request to a JSON Lines manifest and saves the full request body as a pretty-printed payload
    // file (see README). Disabled by default.
    "Recording": {
      "Enabled": false
      // "OutputDirectory": "%LOCALAPPDATA%\\OllamaRouter\\inference-requests",
      // "MaxFiles": 500
    },

    // Maximum number of consecutive failures before triggering a forced fallback to cloud overflow (if configured and enabled)
    "MaxConsecutiveFailures": 2,

    // Allowed difference in estimated prompt tokens between adjacent requests to consider them part of the same retry streak
    "ConsecutiveFailuresTokenTolerance": 4000,

    // DYNAMIC CONTEXT SIZING (Phase 2, MoE-only two-bucket ladder): MoE requests are sized
    // between EXACTLY two buckets and "options.num_ctx" is injected/overwritten in the
    // outgoing inference payload:
    //   1. the node's pre-configured context (Modelfile num_ctx) = the OPTIMAL baseline bucket;
    //   2. the model's native context length = the single EXTENSIBLE bucket (an optional
    //      Models:{model}:MaxContextTokens cap applies min(native, override) across all nodes,
    //      e.g. a VRAM-tuned or Q8-lossless ceiling).
    // Dense models are NEVER bucketed or expanded (a dense KV refill costs 300 s+): with
    // DenseClampEnabled (default true) an oversized static client num_ctx is clamped DOWN to
    // the node's pre-configured context (one-time KV reallocation, OOM protection); when the
    // client value is absent or <= pre-configured the payload is untouched. Set
    // DenseClampEnabled to false for pure dense pass-through. Disabled by default.
    // Retired keys (task #26, bind-and-ignore with a startup warning): BucketStepTokens,
    // Profiles:*:IntermediateContext, and the dense profile names DenseDesktop16gb /
    // DenseServer96gb / SmallDense. Example (uncomment to use):
    //
    // "DynamicContext": {
    //   "Enabled": true,
    //   "DenseClampEnabled": true,            // dense: clamp oversized client num_ctx down (default true)
    //   "AutoShrinkCooldownTurns": 3,         // consumed by the Auto-Shrink Manager (MoE only)
    //   "AutoShrinkIdleTimeoutSeconds": 60    // consumed by the Auto-Shrink Manager (MoE only)
    // },
    //
    // Optional per-model extensible-capacity cap (applied to MoE sizing + Stage-1 MoE
    // qualification as min(native ?? 128k, MaxContextTokens)): uncomment to use:
    //
    // "Models": {
    //   "qwen3.6-35b-a3b": { "MaxContextTokens": 200000 }
    // },

    // Optional pricing configuration to estimate 7-day savings and cloud overflow cost. Unset by default.
    "Pricing": {
      "PromptPricePerMillion": 0.15,
      "CompletionPricePerMillion": 0.50,
      "Currency": "$"
    },

    // In-terminal live activity monitor configuration (zero VRAM overhead).
    "TerminalMonitoring": {
      "Enabled": true,
      "RefreshIntervalSeconds": 2.0
    },

    // MULTI-TARGET FLEET (alternative to the legacy LocalUrl/RemoteUrl above): declare an
    // arbitrary list of named targets. When "Targets" is non-empty, LocalUrl/RemoteUrl are no
    // longer used for YARP cluster generation (routing handlers still use them until the
    // follow-up fleet decision tasks land). Each target maps to one YARP route/cluster, selected
    // via the internal X-Ollama-Target header. Example (uncomment to use):
    //
    // NOTE: this is the factory-default fleet. Override Targets/CloudOverflow in
    // config/config.json next to the executable (user values win over these defaults).
    "Targets": [
      {
        "Name": "Local",
        "Url": "http://127.0.0.1:11435",
        "HardwareHint": "16gb", // or "8gb" / "96gb"; normalizes to effective MaxVramMB
        "MaxVramMB": null, // optional explicit override of the HardwareHint preset
        "MaxParallel": 1
      },
      {
        "Name": "Remote",
        "Url": "http://aiserver:11434",
        "HardwareHint": "96gb",
        "MaxParallel": 1,
        "Enabled": true
      }
    ],
    "CloudOverflow": {
      "Enabled": true,
      "DefaultModel": "glm-5.3-flash:cloud",
      "PreferredRelayTarget": "Local"
    }
  }
}
