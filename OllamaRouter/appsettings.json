{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "OllamaRouter": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OllamaRouter": {
    // NOTE: "Models[*]:MaxLocalTokens" and "Models[*]:MinRequiredVramMB" are DEPRECATED and will
    // be superseded by per-target hardware suitability rules; they are slated for removal after
    // the transition release (they still work in this release).
    "Models": {
      "Qwen3.8-27B": {
        "MaxLocalTokens": 36864,
        "MinRequiredVramMB": 13500,
        "CloudModel": "glm-5.3-flash:cloud" // Overflow model name if local and remote server cannot handle the request (busy, context size)
      }
    },
    "LocalUrl": "http://127.0.0.1:11435",
    "RemoteUrl": "http://192.168.1.25:11434",
    "BindAddress": "http://+:11434/",

    // Worst-case margin above the estimator (incl. chat-template overhead). Measured residual
    // error is within ~±10% once the recorded payload text (incl. "reasoning") is fully counted.
    "TokenEstimationOverheadFactor": 1.025,

    // Estimator strategy: "Heuristic" (default, fast, zero memory footprint, saves ~24MB RAM) or "Tiktoken" (cl100k_base)
    "TokenEstimator": "Heuristic",

    // Optional recording mode to investigate estimated vs actual token counts: appends each inference
    // request to a JSON Lines manifest and saves the full request body as a pretty-printed payload
    // file (see README). Disabled by default.
    "Recording": {
      "Enabled": false
      // "OutputDirectory": "%LOCALAPPDATA%\\OllamaRouter\\inference-requests",
      // "MaxFiles": 500
    },

    // Maximum number of consecutive failures before triggering a forced fallback to cloud overflow (if configured and enabled)
    "MaxConsecutiveFailures": 2,

    // Allowed difference in estimated prompt tokens between adjacent requests to consider them part of the same retry streak
    "ConsecutiveFailuresTokenTolerance": 4000,

    // DYNAMIC CONTEXT SIZING (Phase 2): the router selects a quantized context bucket per
    // (target, model, prompt) triple and injects/overwrites "options.num_ctx" in the outgoing
    // inference payload. Enabled by default with the built-in profile table (Moe 184320/221184/
    // 262144; DenseDesktop16gb 32768/40960/49152; DenseServer96gb 65536/131072/262144;
    // SmallDense 32768/65536/131072). A static client num_ctx is an upper-bound preference and
    // never a disqualifier: it is clamped to the target's hardware-safe bucket, never rejected.
    // Custom profiles only need DefaultContext + MaxContext (the intermediate bucket is
    // synthesized on the BucketStepTokens grid). Example (uncomment to use):
    //
    // "DynamicContext": {
    //   "Enabled": true,
    //   "BucketStepTokens": 32768,
    //   "AutoShrinkCooldownTurns": 3,      // consumed by the Auto-Shrink Manager (later release)
    //   "AutoShrinkIdleTimeoutSeconds": 60, // consumed by the Auto-Shrink Manager (later release)
    //   "Profiles": {
    //     "Moe": { "DefaultContext": 184320, "IntermediateContext": 221184, "MaxContext": 262144 },
    //     "MyCustom": { "DefaultContext": 32768, "MaxContext": 131072 }  // intermediate = 98304 (synthesized)
    //   }
    // },

    // Optional pricing configuration to estimate 7-day savings and cloud overflow cost. Unset by default.
    "Pricing": {
      // Prices for "glm-5.3-flash:cloud" (actual cost should be lower, as cached tokens have a lower cost)
      "PromptPricePerMillion": 0.15,
      "CompletionPricePerMillion": 0.50,
      "Currency": "$"
    },

    // In-terminal live activity monitor configuration (zero VRAM overhead).
    "TerminalMonitoring": {
      "Enabled": true,
      "RefreshIntervalSeconds": 2.0
    },

    // MULTI-TARGET FLEET (alternative to the legacy LocalUrl/RemoteUrl above): declare an
    // arbitrary list of named targets. When "Targets" is non-empty, LocalUrl/RemoteUrl are no
    // longer used for YARP cluster generation (routing handlers still use them until the
    // follow-up fleet decision tasks land). Each target maps to one YARP route/cluster, selected
    // via the internal X-Ollama-Target header. Example (uncomment to use):
    //
    // "Targets": [
    //   {
    //     "Name": "desktop",
    //     "Url": "http://127.0.0.1:11435",
    //     "HardwareHint": "96gb",        // or "8gb" / "16gb"; normalizes to effective MaxVramMB
    //     "MaxVramMB": null,             // optional explicit override of the HardwareHint preset
    //     "MaxParallel": 2
    //   },
    //   {
    //     "Name": "laptop",
    //     "Url": "http://192.168.1.30:11434",
    //     "HardwareHint": "16gb",
    //     "MaxParallel": 1
    //   },
    //   {
    //     "Name": "server1",
    //     "Url": "http://aiserver.local:11434",
    //     "HardwareHint": "96gb",
    //     "MaxParallel": 4,
    //     "Enabled": true
    //   }
    // ]
  }
}
